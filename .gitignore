# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---- Node / frontend ----
node_modules/
dist/
*.tsbuildinfo

# ---- Databases / generated data ----
# SQLite dev DB is recreated from Alembic migrations on first boot.
backend/data/*.db
backend/data/*.sqlite3

# ---- Tooling exhaust ----
.playwright-mcp/
# Personal per-user Claude Code overrides — never commit (may hold local grants).
.claude/settings.local.json

# ---- Local dev-server runtime (managed by scripts/serve.sh) ----
# Globbed to cover the previous run's log, rolled aside on each start.
.backend*.pid
.backend*.log
.backend*.log.*
.frontend*.pid
.frontend*.log
.frontend*.log.*

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Machine-local working files ----
# One directory, so the next local file needs no new entry here. Anything that
# is yours rather than the project's — scratch notes, run logs, private
# research — goes in `local/` and stays out of this file.
#
# Per-file personal paths do NOT belong in .gitignore. This file is public and
# shared, so an entry here publishes the TITLE of a private document to anyone
# who clones the repo. Four such paths were moved to `.git/info/exclude` on
# 2026-08-17 (RUN-THESE-COMMANDS.md and three persona-realism research files).
# `.git/info/exclude` is never committed and is shared across linked worktrees.
# Git's own guidance: .gitignore carries only patterns that benefit OTHER users
# of the repository.
local/
CLAUDE.local.md
