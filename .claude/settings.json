{
  "permissions": {
    "allow": [
      "Bash(git push origin *)",
      "Bash(gh pr create*)",
      "Bash(git fetch:*)",
      "Bash(git pull origin:*)",
      "Bash(git ls-remote:*)",
      "Bash(python3 scripts/gh_api.py:*)"
    ],
    "deny": [
      "Bash(git push*main*)",
      "Bash(git push*--delete*)",
      "Bash(git push* :*)",
      "Bash(git push*--force*)",
      "Bash(git push*-f *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets.json)",
      "Read(**/credentials.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/Library/Keychains/**)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(**/.env)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(env)",
      "Bash(printenv)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.zsh_history*)",
      "Bash(cat ~/.bash_history*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": false,
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "*.github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "localhost",
        "127.0.0.1",
        "auth.openai.com",
        "api.openai.com",
        "*.openai.com",
        "chatgpt.com",
        "*.chatgpt.com",
        "bluffaces.com",
        "*.bluffaces.com",
        "api.anthropic.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        ".",
        "~/.codex",
        "/Users/johncabiles/Documents/Github/poker-analytics"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gcloud",
        "~/Library/Keychains",
        "~/.secrets"
      ]
    }
  }
}
